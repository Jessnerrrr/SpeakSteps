{
  "expo": {
    "name": "SpeakSteps",
    "slug": "SpeakSteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/upload-icon.png",
    "scheme": "speakstepsclean",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-splash-screen",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SpeakSteps to record your practice so you can listen to it.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
