{
  "expo": {
    "name": "SpeakSteps",
    "slug": "SpeakSteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/upload-icon.png",
    "scheme": "speakstepsclean",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.speaksteps.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-splash-screen",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "3d3e52ea-a402-4e0d-9733-d70c83a9f015"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d3e52ea-a402-4e0d-9733-d70c83a9f015"
    },
    "ios": {}
  }
}
