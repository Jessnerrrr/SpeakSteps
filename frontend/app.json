{
  "expo": {
    "name": "SpeakSteps",
    "slug": "SpeakSteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/upload-icon.png",
    "scheme": "speakstepsclean",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}